ENV=development

#SERVER
PORT=3000
SERVER_URL=http://localhost:3000

#Database - REPLACE with your own MongoDB connection string
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>"

#Migration
MIGRATE_MONGO_URI="mongodb://localhost:27017/base"
MIGRATE_AUTOSYNC="true"

#BCRYPT
SALT_ROUNDS="10"

#EMAIL_SERVICE - REPLACE with your own Resend API key
EMAIL_SERVICE_API_KEY="re_your_api_key_here"

#tokens - REPLACE with your own secrets
ACCESS_TOKEN_SECRET="change-me-access-secret"
REFRESH_TOKEN_SECRET="change-me-refresh-secret"
